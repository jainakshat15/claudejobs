# =============================================================================
# claudejobs configuration — copy to .env and fill in.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# Every service (API, dispatcher, bots) reads this same file. Real environment
# variables always win over values set here, so a systemd unit or Task Scheduler
# action can override anything below without editing the file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required for the API and dispatcher)
# -----------------------------------------------------------------------------
# Managed Postgres (Neon, Supabase, RDS, ...). Keep sslmode=require for hosted DBs.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Connection pool sizing. Two services share the database, so keep this modest;
# free tiers often cap total connections at 10-20.
DB_POOL_MIN=1
DB_POOL_MAX=5
# Abort any single query that runs longer than this (milliseconds). 0 disables.
DB_STATEMENT_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
# Bind address. 127.0.0.1 keeps the API private to this machine (recommended).
# Use 0.0.0.0 only behind a firewall/VPN — this API can start processes.
API_HOST=127.0.0.1
API_PORT=8000

# Shared secret for admin/bot routes, sent as the X-Auth-Token header.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-long-random-string

# How the dispatcher, bots and jobctl reach the API.
API_BASE_URL=http://127.0.0.1:8000

# Markdown transcript of every HTTP request/response. Empty string disables it.
REQUEST_LOG_FILE=logs/requests.md
# Rotate the transcript once it passes this size (MB). 0 disables rotation.
REQUEST_LOG_MAX_MB=20

# -----------------------------------------------------------------------------
# Dispatcher / workers
# -----------------------------------------------------------------------------
# How many Claude sessions may run at once on this machine.
MAX_CONCURRENT_JOBS=2
# Seconds between queue polls.
POLL_INTERVAL_SECONDS=5
# A job whose worker stops heartbeating for this long is considered dead and is
# retried or failed. Must be comfortably larger than HEARTBEAT_INTERVAL_SECONDS.
JOB_LEASE_SECONDS=180
HEARTBEAT_INTERVAL_SECONDS=30
# Wall-clock limit per job. 0 disables.
JOB_TIMEOUT_MINUTES=240
# How long a question to the poster may stay unanswered before the job is failed
# and its slot freed. 0 disables (the job waits forever).
QUESTION_TIMEOUT_MINUTES=180
# Default retry count for new jobs (1 = a single attempt, no retry).
DEFAULT_MAX_ATTEMPTS=1
# Identifies this machine in the jobs table. Defaults to the hostname.
#WORKER_ID=studio-laptop

# -----------------------------------------------------------------------------
# Claude launch settings
# -----------------------------------------------------------------------------
# Path to the Claude Code CLI. Leave empty to find it on PATH.
# May also be a command with arguments, e.g. to run the npm build through node:
#   CLAUDE_BIN=node C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\cli.js
# Prefer the native executable: a .cmd/.bat shim cannot carry multi-line
# arguments, so jobs launched through one have their prompt passed as a file.
#CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
# Permission mode for unattended jobs:
#   bypassPermissions — never prompts (what "fully auto" needs)
#   acceptEdits       — edits freely, still prompts for risky shell commands
#   plan / default    — interactive, will stall unattended
DEFAULT_PERMISSION_MODE=bypassPermissions
# Default model for jobs that don't name one (sonnet / opus / haiku / full id).
#DEFAULT_MODEL=sonnet

# Terminal used to show each job:
#   auto     — Windows Terminal, then cmd; gnome-terminal/konsole/... on Linux
#   wt | cmd | gnome-terminal | konsole | xfce4-terminal | alacritty | kitty | xterm | macos
#   headless — no window at all; Claude's output goes to the job log file
TERMINAL_MODE=auto
# Keep the window open after a job ends so you can read the final screen.
KEEP_TERMINAL_OPEN=true

# Per-job logs (wrapper events; also Claude's raw output in headless mode).
LOG_DIR=logs/jobs
LOG_LEVEL=INFO

# Safety rail: jobs may only run inside these directories (os.pathsep separated:
# ";" on Windows, ":" on Linux/macOS). Empty means any directory is allowed.
#ALLOWED_ROOTS=D:\work;D:\repos
# Directory used when a poster doesn't name one.
#DEFAULT_DIRECTORY=D:\work

# -----------------------------------------------------------------------------
# Product questions (/ask-sales-bot, /ask-od)
# -----------------------------------------------------------------------------
# Each product is answered from two places: the repository that decides what it
# does, and the documentation tree describing what it promises. Relative values
# are resolved next to this checkout, which is where they normally sit.
#SALES_BOT_CODE_DIR=flexi-demo
#SALES_BOT_DOCS_DIR=docs/Sales-Bot
#OD_CODE_DIR=OD
#OD_DOCS_DIR=docs/Organizational-Development
# Where a question's job runs. Defaults to the nearest directory holding that
# product's two; set it if that lands somewhere ALLOWED_ROOTS refuses.
#SALES_BOT_DIRECTORY=D:\Eubrics\Claude
#OD_DIRECTORY=D:\Eubrics\Claude
# A question is research, not a build — it gets a shorter leash than a work job.
#SALES_BOT_TIMEOUT_MINUTES=20
#OD_TIMEOUT_MINUTES=20

# -----------------------------------------------------------------------------
# Telegram bot
# -----------------------------------------------------------------------------
# From @BotFather. Leave empty to disable the Telegram bot.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to run jobs. REQUIRED when
# the bot is enabled — an empty list refuses to start.
TELEGRAM_ALLOWED_USERS=
# Optional per-chat default directories, as JSON: {"<chat_id>": "<path>"}
#TELEGRAM_CHAT_DIRS={"-1001234567890": "D:\\work\\web"}

# -----------------------------------------------------------------------------
# Slack bot (Socket Mode — no public URL needed)
# -----------------------------------------------------------------------------
# xoxb-... from OAuth & Permissions. Leave empty to disable the Slack bot.
SLACK_BOT_TOKEN=
# xapp-... app-level token with connections:write (Socket Mode).
SLACK_APP_TOKEN=
# Comma-separated Slack member ids (U…) allowed to run jobs. REQUIRED when enabled.
SLACK_ALLOWED_USERS=
#SLACK_CHANNEL_DIRS={"C01234567": "D:\\work\\web"}

# Seconds between outbound-delivery polls by each bot.
OUTBOUND_POLL_SECONDS=3
